# Copy to .env and chmod 600 .env. One-line literal values; never source this file.
# Base64-encode binary/key files; use whole-line comments, not inline comments.
MACOS_CERTIFICATE_P12=
MACOS_CERTIFICATE_PASSWORD=
MACOS_SIGNING_IDENTITY=
MACOS_TEAM_ID=
NOTARY_API_KEY_ID=
NOTARY_API_ISSUER_ID=
NOTARY_API_KEY_P8=
# Generate an app-specific key with Scripts/sparkle-keys.sh, then export privately.
# Its public half is committed in Resources/sparkle_ed_public_key.txt; releases check they match.
SPARKLE_PRIVATE_KEY=
# Public HTTPS hosting; uploaded as a GitHub environment variable.
UNIFI_SPARKLE_FEED_URL=https://raw.githubusercontent.com/thorrsson/osx-unifi/main/appcast.xml
